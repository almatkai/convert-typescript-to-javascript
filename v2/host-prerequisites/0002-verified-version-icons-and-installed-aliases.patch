+pub(super) fn replacement_id(ctx: &CoreContext, requested: &str) -> Result<Option<String>, String> {
+    let matches: HashSet<String> = collect(ctx).into_iter()
+        .filter(|entry| entry.id.starts_with("com.tezbar.native.") && entry.manifest["healthError"].is_null())
+        .filter(|entry| entry.manifest["replaces"].as_array().is_some_and(|aliases| aliases.iter().any(|alias| alias.as_str() == Some(requested))))
+        .map(|entry| entry.id).collect();
+    if matches.len() > 1 { return Err("Ambiguous installed extension replacement".into()); }
+    Ok(matches.into_iter().next())
 }
 
