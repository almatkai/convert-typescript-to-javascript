    "com.tezbar.convert-typescript-to-javascript",
    "raycast.convert-typescript-to-javascript"
  ],
  "capabilities": [
    "clipboard.read",
    "selection.read",
    "clipboard.write",
    "clipboard.pasteText"
  ],
