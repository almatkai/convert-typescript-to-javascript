      "platforms": [
        "macOS",
        "Windows"
      ],
      "timeoutMs": 30000,
      "refreshMs": null,
      "concurrency": "reject-while-busy"
    },
    {
      "name": "copy-to-clipboard",
      "title": "Copy TypeScript as JavaScript",
      "mode": "no-view",
      "runtime": "rust",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "timeoutMs": 30000,
      "refreshMs": null,
      "concurrency": "reject-while-busy"
    }
  ],
  "preferences": [],
